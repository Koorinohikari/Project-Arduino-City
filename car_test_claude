// ===== MOTORES =====
const int ENA = 2;
const int IN1 = 4;
const int IN2 = 5;

const int ENB = 3;
const int IN3 = 6;
const int IN4 = 7;

const int SPEED = 20;


// ===== TCS3200 =====
const int S0 = 22;
const int S1 = 23;
const int S2 = 24;
const int S3 = 25;
const int TCS_OUT = 26;
// E0 conectado directo a GND por hardware — no requiere control por software

const int RED_THRESHOLD = 35;
const int RED_MARGIN = 5;

// Tiempo de espera tras detectar rojo antes de permitir movimiento nuevamente
// (evita jittering por detecciones en bursts / intermitentes)
const float RED_STOP_SECONDS = 3.0;
const unsigned long RED_STOP_MS = (unsigned long)(RED_STOP_SECONDS * 1000);
unsigned long redStopUntil = 0;  // marca de tiempo (millis) hasta la cual el movimiento queda bloqueado


// ===== SENSOR IR DE PROXIMIDAD =====
const int IR_SENSOR = 27;


// ===== SENSORES DE SEGUIMIENTO DE LÍNEA (L y R) =====
const int LINE_SENSOR_L = 28;
const int LINE_SENSOR_R = 29;  // ajusta este pin al que corresponda en tu cableado

// Detecta línea blanca cuando la salida del sensor es LOW
const int WHITE_DETECTED = LOW;


// ======================================================
// SETUP
// ======================================================

void setup() {

  // Motores
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // TCS3200
  pinMode(S0, OUTPUT);
  pinMode(S1, OUTPUT);
  pinMode(S2, OUTPUT);
  pinMode(S3, OUTPUT);
  pinMode(TCS_OUT, INPUT);

  // Sensor IR
  pinMode(IR_SENSOR, INPUT);

  // Sensores de línea
  pinMode(LINE_SENSOR_L, INPUT);
  pinMode(LINE_SENSOR_R, INPUT);

  // Configuración TCS3200
  digitalWrite(S0, HIGH);
  digitalWrite(S1, LOW);

  Serial.begin(9600);

  Serial.println("Sistema iniciado.");
}


// ======================================================
// CONTROL DE MOTORES
// ======================================================

void leftSide(int dir) {

  if (dir == 1) {

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    analogWrite(ENA, SPEED);
  }

  else if (dir == -1) {

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    analogWrite(ENA, SPEED);
  }

  else {

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    analogWrite(ENA, 0);
  }
}


void rightSide(int dir) {

  if (dir == 1) {

    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    analogWrite(ENB, SPEED);
  }

  else if (dir == -1) {

    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    analogWrite(ENB, SPEED);
  }

  else {

    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    analogWrite(ENB, 0);
  }
}


// ======================================================
// SENSOR DE COLOR
// ======================================================

long readColorPulse(bool s2, bool s3) {

  digitalWrite(S2, s2);
  digitalWrite(S3, s3);

  delay(10);

  return pulseIn(TCS_OUT, LOW, 25000);
}


bool isRedDetected() {

  long redPW = readColorPulse(LOW, LOW);
  long bluePW = readColorPulse(LOW, HIGH);
  long greenPW = readColorPulse(HIGH, HIGH);

  if (redPW == 0 || greenPW == 0 || bluePW == 0)
    return false;

  bool strongEnough = redPW < RED_THRESHOLD;

  bool dominant =
    (redPW + RED_MARGIN < greenPW) &&
    (redPW + RED_MARGIN < bluePW);

  return strongEnough && dominant;
}


// ======================================================
// SENSOR IR DE PROXIMIDAD
// ======================================================

bool isObjectDetected() {

  return digitalRead(IR_SENSOR) == LOW;
}


// ======================================================
// SENSORES DE SEGUIMIENTO DE LÍNEA
// ======================================================

bool isWhiteLineDetected(int sensorPin) {

  return digitalRead(sensorPin) == WHITE_DETECTED;
}


// ======================================================
// MOVIMIENTO
// ======================================================

void moveForward() {

  leftSide(1);
  rightSide(-1);
}


void turnLeft() {

  // Pivote: rueda izquierda detenida, derecha avanza -> gira hacia la izquierda
  leftSide(0);
  rightSide(-1);
}


void turnRight() {

  // Pivote: rueda derecha detenida, izquierda avanza -> gira hacia la derecha
  leftSide(1);
  rightSide(0);
}


void stopVehicle() {

  leftSide(0);
  rightSide(0);
}

void moveBackward() {

  leftSide(-1);
  rightSide(1);
}


// ======================================================
// SEGUIMIENTO DE LÍNEA Y SENSORES
// ======================================================

void followLine() {

  // ==================================================
  // BLOQUEO POR DETECCIÓN PREVIA DE ROJO
  // ==================================================

  if (millis() < redStopUntil) {

    stopVehicle();
    return;
  }


  // ==================================================
  // SENSOR DE COLOR
  // ==================================================

  if (isRedDetected()) {

    Serial.println("ROJO DETECTADO");

    stopVehicle();
    redStopUntil = millis() + RED_STOP_MS;
    return;
  }


  // ==================================================
  // SENSOR IR DE PROXIMIDAD
  // ==================================================

  if (isObjectDetected()) {

    Serial.println("OBSTACULO DETECTADO");

    stopVehicle();
    return;
  }


  // ==================================================
  // SEGUIMIENTO DE LÍNEA (L y R)
  // ==================================================

  bool leftOnLine = isWhiteLineDetected(LINE_SENSOR_L);
  bool rightOnLine = isWhiteLineDetected(LINE_SENSOR_R);

  if (leftOnLine && rightOnLine) {

    moveForward();
  }

  else if (leftOnLine && !rightOnLine) {

    turnLeft();
  }

  else if (!leftOnLine && rightOnLine) {

    turnRight();
  }

  else {

    // Ningún sensor detecta la línea
    moveBackward();
  }
}


// ======================================================
// LOOP PRINCIPAL
// ======================================================

void loop() {

  followLine();

  delay(100);
}