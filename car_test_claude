const int ENA = 9;
const int IN1 = 8;
const int IN2 = 7;

const int ENB = 10;
const int IN3 = 6;
const int IN4 = 5;

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
}

void driveForward(int speed) {
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void driveBackward(int speed) {
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

void rotateLeft(int speed) {
  // left side spins backward, right side spins forward
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void rotateRight(int speed) {
  // left side spins forward, right side spins backward
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

void stopMotors() {
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
}

void loop() {
  int speed = 150; // 0-255, adjust as needed

  driveForward(speed);
  delay(500);
  stopMotors();
  delay(1000);

  rotateLeft(speed);
  delay(400);
  stopMotors();
  delay(1000);

  rotateRight(speed);
  delay(400); // same duration as rotateLeft cancels the rotation -> faces front again
  stopMotors();
  delay(1000);

  driveBackward(speed);
  delay(500);
  stopMotors();
  delay(1000);
}