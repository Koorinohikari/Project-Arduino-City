// ---- Pin definitions ----
const int ENA = 9;  // Left side speed (PWM)
const int IN1 = 8;
const int IN2 = 7;

const int ENB = 3;  // Right side speed (PWM)
const int IN3 = 5;
const int IN4 = 4;

const int SPEED = 150; // 0-255, tweak as needed

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
}

// ---- Low-level side control ----
void leftSide(int dir) { // 1 = forward, -1 = backward, 0 = stop
  digitalWrite(IN1, dir == 1);
  digitalWrite(IN2, dir == -1);
  analogWrite(ENA, dir == 0 ? 0 : SPEED);
}

void rightSide(int dir) {
  digitalWrite(IN3, dir == 1);
  digitalWrite(IN4, dir == -1);
  analogWrite(ENB, dir == 0 ? 0 : SPEED);
}

// ---- High-level movement ----
void moveForward()  { leftSide(1);  rightSide(1);  }
void moveBackward() { leftSide(-1); rightSide(-1); }
void rotateLeft()   { leftSide(-1); rightSide(1);  } // tank turn
void rotateRight()  { leftSide(1);  rightSide(-1); }
void stopAll()       { leftSide(0);  rightSide(0);  }

void loop() {
  moveForward();
  delay(500);
  stopAll();
  delay(1000);

  rotateLeft();
  delay(500);
  stopAll();
  delay(1000);

  rotateRight();
  delay(500);
  stopAll();
  delay(1000);

  // "Face front": left/right rotations above were equal, so it's
  // already facing forward — this is just an explicit re-center pause.
  stopAll();
  delay(1000);

  moveBackward();
  delay(500);
  stopAll();
  delay(1000);

  while (true); // stop repeating; remove this line to loop forever
}