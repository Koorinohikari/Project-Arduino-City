// ---- Pin definitions ----
const int ENA = 2;  // Left side speed (PWM)
const int IN1 = 4;
const int IN2 = 5;

const int ENB = 3;  // Right side speed (PWM)
const int IN3 = 6;
const int IN4 = 7;

int SPEED = 150; // 0-255, tweak as needed
int toggle = false;

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
}

// ---- Low-level side control ----
void leftSide(int dir) { // 1 = forward, -1 = backward, 0 = stop
  digitalWrite(IN1, dir == 1);
  digitalWrite(IN2, dir == -1);
  analogWrite(ENA, dir == 0 ? 0 : SPEED);
}

void rightSide(int dir) {
  digitalWrite(IN3, dir == 1);
  digitalWrite(IN4, dir == -1);
  analogWrite(ENB, dir == 0 ? 0 : SPEED);
}

// ---- High-level movement ----
void moveForward()  { leftSide(1);  rightSide(1);  }
void rotateLeft() { leftSide(-1); rightSide(-1); }
void moveBackward()   { leftSide(-1); rightSide(1);  }
void rotateRight()  { leftSide(1);  rightSide(-1); }
void stopAll()       { leftSide(0);  rightSide(0);  }

void loop() { while (toggle);
  moveForward();
  delay(100);
  stopAll();
  delay(1000);

  moveBackward();
  delay(100);
  stopAll();
  delay(1000);

  toggle = true;
}