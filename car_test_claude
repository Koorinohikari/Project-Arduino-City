// ===== MOTORES =====
const int ENA = 2;
const int IN1 = 4;
const int IN2 = 5;

const int ENB = 3;
const int IN3 = 6;
const int IN4 = 7;

const int SPEED = 20;


// ===== TCS3200 =====
const int S0 = 22;
const int S1 = 23;
const int S2 = 24;
const int S3 = 25;
const int TCS_OUT = 26;

const int RED_THRESHOLD = 50;
const int RED_MARGIN = 1;


// ===== SENSOR IR DE PROXIMIDAD =====
const int IR_SENSOR = 27;


// ===== MOVIMIENTO ACTUAL =====
typedef void (*MoveFunc)();
MoveFunc activeMove = nullptr;


void setup() {

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(S0, OUTPUT);
  pinMode(S1, OUTPUT);
  pinMode(S2, OUTPUT);
  pinMode(S3, OUTPUT);
  pinMode(TCS_OUT, INPUT);

  pinMode(IR_SENSOR, INPUT);

  digitalWrite(S0, HIGH);
  digitalWrite(S1, LOW);

  Serial.begin(9600);
}


void leftSide(int dir) {

  if (dir == 1) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    analogWrite(ENA, SPEED);
  }
  else if (dir == -1) {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    analogWrite(ENA, SPEED);
  }
  else {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    analogWrite(ENA, 0);
  }
}


void rightSide(int dir) {

  if (dir == 1) {
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    analogWrite(ENB, SPEED);
  }
  else if (dir == -1) {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    analogWrite(ENB, SPEED);
  }
  else {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    analogWrite(ENB, 0);
  }
}


long readColorPulse(bool s2, bool s3) {

  digitalWrite(S2, s2);
  digitalWrite(S3, s3);

  delayMicroseconds(50);

  return pulseIn(TCS_OUT, LOW, 25000);
}


bool isRedDetected() {

  long redPW = readColorPulse(LOW, LOW);
  long bluePW = readColorPulse(LOW, HIGH);
  long greenPW = readColorPulse(HIGH, HIGH);

  if (redPW == 0 || greenPW == 0 || bluePW == 0)
    return false;

  bool strongEnough = redPW < RED_THRESHOLD;

  bool dominant =
    (redPW + RED_MARGIN < greenPW) &&
    (redPW + RED_MARGIN < bluePW);

  return strongEnough && dominant;
}


bool isObjectDetected() {

  return digitalRead(IR_SENSOR) == LOW;
}


bool obstacleDetected() {

  return isRedDetected() || isObjectDetected();
}


void stopForObstacle() {

  leftSide(0);
  rightSide(0);
}


void stopAll() {

  leftSide(0);
  rightSide(0);

  activeMove = nullptr;
}


void moveForward() {

  activeMove = moveForward;

  if (obstacleDetected()) {
    stopForObstacle();
    return;
  }

  leftSide(1);
  rightSide(-1);
}


void moveBackward() {

  activeMove = moveBackward;

  if (obstacleDetected()) {
    stopForObstacle();
    return;
  }

  leftSide(-1);
  rightSide(1);
}


void rotateLeft() {

  activeMove = rotateLeft;

  if (obstacleDetected()) {
    stopForObstacle();
    return;
  }

  leftSide(-1);
  rightSide(-1);
}


void rotateRight() {

  activeMove = rotateRight;

  if (obstacleDetected()) {
    stopForObstacle();
    return;
  }

  leftSide(1);
  rightSide(1);
}


void safeDelay(unsigned long ms) {

  unsigned long start = millis();
  bool stopped = false;

  while (millis() - start < ms) {

    if (obstacleDetected()) {

      stopForObstacle();
      stopped = true;

    }
    else if (stopped && activeMove != nullptr) {

      activeMove();
      stopped = false;
    }

    delay(50);
  }
}


void loop() {

  moveForward();
  safeDelay(100);

  stopAll();
  safeDelay(1000);

  rotateLeft();
  safeDelay(100);

  stopAll();
  safeDelay(1000);
  
  rotateRight();
  safeDelay(100);

  stopAll();
  safeDelay(1000);

  moveBackward();
  safeDelay(100);

  stopAll();
  safeDelay(1000);
}
