const int ENA = 9;
const int IN1 = 8;
const int IN2 = 7;

const int ENB = 10;
const int IN3 = 6;
const int IN4 = 5;

// ---- IR sensor ----
const int IR_PIN = 2;

// Set this after checking Serial Monitor:
// If reading = 1 (HIGH) when sensor is OVER the white line, keep HIGH.
// If reading = 0 (LOW) when over the white line, change to LOW.
const int LINE_DETECTED = HIGH;

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(IR_PIN, INPUT);

  Serial.begin(9600); // for calibration - open Serial Monitor to check values
}

void driveForward(int speed) {
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void driveBackward(int speed) {
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

void rotateLeft(int speed) {
  // left side spins backward, right side spins forward
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void rotateRight(int speed) {
  // left side spins forward, right side spins backward
  analogWrite(ENA, speed);
  analogWrite(ENB, speed);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

void stopMotors() {
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
}

void loop() {
  int sensorValue = digitalRead(IR_PIN);
  Serial.println(sensorValue); // watch this while testing over/off the line

  if (sensorValue == LINE_DETECTED) {
    moveForward();
  } else {
    stopAll();
    delay(50);
    rotateRight();  // pivot in place, searching for the line
    delay(100);
    stopAll();
    delay(50);
  }
}