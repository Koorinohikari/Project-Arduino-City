// OLED control pins
#define OLED_CS   30
#define OLED_DC   31
#define OLED_RES  32

// Servo config
#define SERVO_PIN 9
int BARRIER_OPEN_ANGLE   = 90;  // Y — resting/open position
int BARRIER_CLOSED_ANGLE = 0;   // X — closed position
const int SERVO_STEP_DELAY_MS = 15; // ms per degree; higher = slower sweep

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &SPI, OLED_DC, OLED_RES, OLED_CS);
Servo barrierServo;

void setup() {
  if (!display.begin(SSD1306_SWITCHCAPVCC)) { while (true); }
  display.clearDisplay();
  display.display();

  barrierServo.attach(SERVO_PIN);
  barrierServo.write(BARRIER_OPEN_ANGLE); // snap to open on boot; unknown prior position
}

// Prints text on the OLED with configurable size, color, and cursor position
void printOLED(String text, int size = 1, uint16_t color = SSD1306_WHITE, int cursorX = 0, int cursorY = 0) {
  display.clearDisplay();
  display.setTextSize(size);
  display.setTextColor(color);
  display.setCursor(cursorX, cursorY);
  display.print(text);
  display.display();
}

// Prints the stored bitmap centered (adjust x,y as needed)
void printImageOLED(int x = 0, int y = 0) {
  display.clearDisplay();
  display.drawBitmap(x, y, imgBitmap, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
  display.display();
}

// Sweeps the servo one degree at a time toward targetAngle (blocking).
// Provides the "slow close/open" motion instead of an instant write().
void moveServoTo(int targetAngle) {
  int currentAngle = barrierServo.read();
  int step = (targetAngle >= currentAngle) ? 1 : -1;
  for (int a = currentAngle; a != targetAngle + step; a += step) {
    barrierServo.write(a);
    delay(SERVO_STEP_DELAY_MS);
  }
}

void loop() {
  moveServoTo(BARRIER_OPEN_ANGLE); // guarantee barrier is open at start of cycle

  for (int i = 10; i >= 0; i--) {
    if (i >= 10) {
      printOLED(String(i), 9, SSD1306_WHITE, 10);
    } else {
      printOLED(String(i), 9, SSD1306_WHITE, 40);
    }
    delay(1000);
  }

  moveServoTo(BARRIER_CLOSED_ANGLE); // countdown hit 0 — barrier closes
  printImageOLED();                  // show warning image
  delay(2500);                       // hold barrier closed / warning visible
  moveServoTo(BARRIER_OPEN_ANGLE);   // barrier re-opens before reset
}