#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// Screen resolution — change if yours differs (e.g. 128x32)
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

// Control pins — wire these as you like, just match here
#define OLED_CS   53   // Chip Select
#define OLED_DC   9    // Data/Command
#define OLED_RES  8    // Reset

// Hardware SPI constructor: uses Mega's dedicated SCK(52)/MOSI(51) automatically
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &SPI, OLED_DC, OLED_RES, OLED_CS);

void setup() {
  if (!display.begin(SSD1306_SWITCHCAPVCC)) {
    // Halt if display fails to initialize
    while (true);
  }
  display.clearDisplay();
  display.display();

  printOLED("Hello, world!");
}

void loop() {
  // empty for now
}

// Prints a single line of text on the OLED
void printOLED(String text) {
  display.clearDisplay();      // wipe previous frame
  display.setTextSize(1);      // 1 = smallest readable size
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);     // top-left corner
  display.print(text);
  display.display();           // pushes buffer to screen — nothing shows without this
}