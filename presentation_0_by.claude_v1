// VERSION: Merged — Traffic Light + City Lights (no UDS)
// Note: Merged utilizing Claude AI, due to my lack of both skill & time.
// PIN CHANGE NOTICE:
//   redPin    was 4 in the original Traffic Light code → moved to pin 2
//             (reserved for UDS echo in the full version; kept here for
//              consistency so wiring stays the same if UDS is added later).
//   yellowPin was 5 in the original Traffic Light code → moved to pin 9
//             (pins 5 & 6 share Timer 0, which caused the yellow fade to
//              inversely modulate the city lights PWM output on pin 6).
//             Pin 9 uses Timer 1 — fully isolated from cityLightsPin (pin 6).


// ─── PIN DEFINITIONS ──────────────────────────────────────────────────────────

// Traffic Light
const int greenPin  = 3;
const int redPin    = 2;
const int yellowPin = 9;

// City Lights
const int cityLightsPin = 6;
const int ldrPin        = A0;
const int ldrThreshold  = 500;


// ─── STATE VARIABLES ──────────────────────────────────────────────────────────

// Traffic Light — non-blocking state machine
enum TLPhase { TL_GREEN, TL_YELLOW, TL_RED };
TLPhase       tlPhase      = TL_GREEN;
unsigned long tlPhaseStart = 0;
const float   tlInterval   = 3.0;  // seconds per base phase

// City Lights
bool          cityLightsState = false;
bool          ldrPending      = false;
bool          ldrPendingState = false;
unsigned long ldrChangeTime   = 0;
const unsigned long LDR_DEBOUNCE = 500;  // ms a reading must hold before acting

// Sensor poll timing
unsigned long lastSensorRead        = 0;
const unsigned long sensorInterval  = 50;  // ms between sensor reads


// ─── SHARED UTILITIES ─────────────────────────────────────────────────────────

void visFade(int pin, bool fadeIn, float durationSec) {
  float stepDelay = (durationSec * 1000.0) / 256.0;
  if (fadeIn) {
    for (int i = 0; i <= 255; i++) { analogWrite(pin, i); delay(stepDelay); }
  } else {
    for (int i = 255; i >= 0; i--) { analogWrite(pin, i); delay(stepDelay); }
  }
}


// ─── TRAFFIC LIGHT (non-blocking) ─────────────────────────────────────────────

void updateTrafficLight() {
  unsigned long now     = millis();
  unsigned long elapsed = now - tlPhaseStart;

  switch (tlPhase) {

    case TL_GREEN:
      digitalWrite(greenPin, HIGH);
      if (elapsed >= (unsigned long)(tlInterval * 1000UL)) {
        digitalWrite(greenPin, LOW);
        tlPhase      = TL_YELLOW;
        tlPhaseStart = now;
      }
      break;

    case TL_YELLOW: {
      unsigned long cycleDur = (unsigned long)(tlInterval * 1000.0 / 6.0);
      int           cycleNum = (int)(elapsed / cycleDur);
      unsigned long cyclePos = elapsed % cycleDur;

      if (cycleNum >= 6) {
        analogWrite(yellowPin, 0);
        tlPhase      = TL_RED;
        tlPhaseStart = now;
      } else {
        int pwm = (cycleNum % 2 == 0)
          ? (int)map(cyclePos, 0, cycleDur, 0, 255)
          : (int)map(cyclePos, 0, cycleDur, 255, 0);
        analogWrite(yellowPin, pwm);
      }
      break;
    }

    case TL_RED:
      digitalWrite(redPin, HIGH);
      if (elapsed >= (unsigned long)(tlInterval * 2000UL)) {
        digitalWrite(redPin, LOW);
        tlPhase      = TL_GREEN;
        tlPhaseStart = now;
      }
      break;
  }
}


// ─── CITY LIGHTS ──────────────────────────────────────────────────────────────

void detectLight() {
  int  ldrValue   = analogRead(ldrPin);
  bool shouldBeOn = (ldrValue < ldrThreshold);

  if (shouldBeOn != cityLightsState) {
    if (!ldrPending) {
      ldrPending      = true;
      ldrPendingState = shouldBeOn;
      ldrChangeTime   = millis();
    } else if (shouldBeOn == ldrPendingState &&
               millis() - ldrChangeTime >= LDR_DEBOUNCE) {
      ldrPending      = false;
      cityLightsState = shouldBeOn;
      visFade(cityLightsPin, shouldBeOn, 1.0);
    }
  } else {
    ldrPending = false;
  }
}


// ─── SETUP ────────────────────────────────────────────────────────────────────

void setup() {
  pinMode(greenPin,      OUTPUT);
  pinMode(redPin,        OUTPUT);
  pinMode(yellowPin,     OUTPUT);
  pinMode(cityLightsPin, OUTPUT);

  tlPhaseStart = millis();
}


// ─── MAIN LOOP ────────────────────────────────────────────────────────────────

void loop() {
  delay(10);
  updateTrafficLight();

  unsigned long now = millis();
  if (now - lastSensorRead >= sensorInterval) {
    lastSensorRead = now;
    detectLight();
  }
}
