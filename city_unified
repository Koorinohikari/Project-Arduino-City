// Prints text on the OLED. No-ops safely if the display isn't available.
void printOLED(const char* text, int size = 1, uint16_t color = SSD1306_WHITE, int cursorX = 0, int cursorY = 0) {
  if (!oledAvailable) return;
  display.clearDisplay();
  display.setTextSize(size);
  display.setTextColor(color);
  display.setCursor(cursorX, cursorY);
  display.print(text);
  display.display();
}

// Draws the stored warning bitmap. No-ops safely if the display isn't available.
void printImageOLED(int x = 0, int y = 0) {
  if (!oledAvailable) return;
  display.clearDisplay();
  display.drawBitmap(x, y, imgBitmap, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
  display.display();
}

void showCountdown(int val) {
  char buf[4];
  itoa(val, buf, 10); // avoids per-second String allocation
  if (val >= 10) printOLED(buf, 9, SSD1306_WHITE, 10);
  else           printOLED(buf, 9, SSD1306_WHITE, 40);
}

void servoStartMove(int target) {
  servoTargetAngle = target;
  lastServoStep = millis();
}

// Advances the servo by at most one degree, paced by SERVO_STEP_DELAY_MS.
// Returns true once the target angle is reached.
bool servoStep() {
  if (servoCurrentAngle == servoTargetAngle) return true;
  unsigned long now = millis();
  if (now - lastServoStep < SERVO_STEP_DELAY_MS) return false;
  lastServoStep = now;
  servoCurrentAngle += (servoTargetAngle > servoCurrentAngle) ? 1 : -1;
  barrierServo.write(servoCurrentAngle);
  return (servoCurrentAngle == servoTargetAngle);
}

void updateBarrier() {
  unsigned long now = millis();

  switch (barrierState) {
    case BAR_OPENING:
      if (servoStep()) {
        barrierState = BAR_COUNTDOWN;
        countdownValue = 10;
        lastCountdownTick = now;
        showCountdown(countdownValue);
      }
      break;

    case BAR_COUNTDOWN:
      if (now - lastCountdownTick >= COUNTDOWN_TICK_MS) {
        lastCountdownTick = now;
        countdownValue--;
        if (countdownValue < 0) {
          barrierState = BAR_CLOSING;
          servoStartMove(BARRIER_CLOSED_ANGLE);
        } else {
          showCountdown(countdownValue);
        }
      }
      break;

    case BAR_CLOSING:
      if (servoStep()) {
        printImageOLED();
        barrierState = BAR_WARNING_HOLD;
        barrierStateStart = now;
      }
      break;

    case BAR_WARNING_HOLD:
      if (now - barrierStateStart >= WARNING_HOLD_MS) {
        barrierState = BAR_OPENING;
        servoStartMove(BARRIER_OPEN_ANGLE);
      }
      break;
  }
}

// ============================================================================
//  SETUP
// ============================================================================

void setup() {
  Serial.begin(9600);

  pinMode(I1_GREEN_PIN, OUTPUT);
  pinMode(I1_RED_PIN, OUTPUT);
  pinMode(I1_YELLOW_PIN, OUTPUT);
  pinMode(I1_PED_GREEN_PIN, OUTPUT);
  pinMode(I1_PED_RED_PIN, OUTPUT);
  pinMode(I1_BUZZER_PIN, OUTPUT);

  pinMode(I2_GREEN_PIN, OUTPUT);
  pinMode(I2_RED_PIN, OUTPUT);
  pinMode(I2_YELLOW_PIN, OUTPUT);
  pinMode(I2_PED_GREEN_PIN, OUTPUT);
  pinMode(I2_PED_RED_PIN, OUTPUT);
  pinMode(I2_BUZZER_PIN, OUTPUT);

  pinMode(CITY_LIGHT_PIN, OUTPUT);
  // LDR_PIN is analog input — no pinMode() needed

  oledAvailable = display.begin(SSD1306_SWITCHCAPVCC);
  if (!oledAvailable) {
    Serial.println(F("[WARN] OLED not detected - continuing without display."));
  } else {
    display.clearDisplay();
    display.display();
  }

  barrierServo.attach(SERVO_PIN);
  barrierServo.write(BARRIER_OPEN_ANGLE);
  servoCurrentAngle = BARRIER_OPEN_ANGLE;
  servoTargetAngle  = BARRIER_OPEN_ANGLE;

  enterGreen(); // initializes both intersections to a deterministic state

  barrierState = BAR_OPENING; // servo already at target -> falls straight
  barrierStateStart = millis(); // into the countdown on the first update
}

// ============================================================================
//  MAIN LOOP  —  everything below is non-blocking; no delay() anywhere
// ============================================================================

void loop() {
  updateIntersections();
  updateCityLights();
  updateBarrier();
}
