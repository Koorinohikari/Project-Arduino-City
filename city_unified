// --- Intersections ---
const unsigned long GREEN_DURATION_MS  = 5000UL;
const unsigned long YELLOW_DURATION_MS = 3000UL;
const unsigned long PED_BLINK_INTERVAL_MS = YELLOW_DURATION_MS / 6; // 3 blink cycles across the yellow phase, same ratio as the original design
const unsigned int  BUZZER_FREQ_HZ     = 2000;
const unsigned long BUZZER_BEEP_MS     = 150UL; // must stay < PED_BLINK_INTERVAL_MS

// --- City lights ---
const int LDR_ON_THRESHOLD   = 450;  // ambient reading below this -> lights ON
const int LDR_OFF_THRESHOLD  = 550;  // ambient reading above this -> lights OFF
                                      // (gap between the two = hysteresis band,
                                      //  prevents flicker from a noisy/missing LDR)
const unsigned long LDR_POLL_INTERVAL_MS = 200UL;
const unsigned long CITY_FADE_DURATION_MS = 1000UL;

// --- Train barrier ---
const int BARRIER_OPEN_ANGLE   = 90;
const int BARRIER_CLOSED_ANGLE = 0;
const unsigned long SERVO_STEP_DELAY_MS = 15UL; // ms per degree of sweep
