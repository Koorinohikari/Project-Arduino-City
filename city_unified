const unsigned long WARNING_HOLD_MS     = 2500UL;

// ============================================================================
//  GENERIC NON-BLOCKING FADER  (replaces the old blocking visFade())
// ============================================================================

struct Fader {
  uint8_t pin;
  unsigned long stepIntervalMs;
  unsigned long lastStepTime;
  int value;
  int target;
  bool active;
};

void faderStart(Fader &f, uint8_t pin, int fromValue, int toValue, unsigned long durationMs) {
  f.pin = pin;
  f.value = fromValue;
  f.target = toValue;
  int steps = abs(toValue - fromValue);
  f.stepIntervalMs = (steps > 0) ? (durationMs / (unsigned long)steps) : durationMs;
  if (f.stepIntervalMs == 0) f.stepIntervalMs = 1;
  f.lastStepTime = millis();
  f.active = true;
  analogWrite(pin, fromValue);
}

// Call every loop() pass. Returns true the instant the fade reaches target.
bool faderUpdate(Fader &f) {
  if (!f.active) return false;
  unsigned long now = millis();
  if (now - f.lastStepTime < f.stepIntervalMs) return false;
  f.lastStepTime = now;
  if (f.value < f.target) f.value++;
  else if (f.value > f.target) f.value--;
  analogWrite(f.pin, f.value);
  if (f.value == f.target) {
    f.active = false;
    return true;
  }
  return false;
}

// ============================================================================
//  INTERSECTIONS (2x vehicular + pedestrian, inverse master FSM)
// ============================================================================

struct Intersection {
  uint8_t greenPin, redPin, yellowPin;
  uint8_t pedGreenPin, pedRedPin, buzzerPin;
};

Intersection I1 = { I1_GREEN_PIN, I1_RED_PIN, I1_YELLOW_PIN, I1_PED_GREEN_PIN, I1_PED_RED_PIN, I1_BUZZER_PIN };
Intersection I2 = { I2_GREEN_PIN, I2_RED_PIN, I2_YELLOW_PIN, I2_PED_GREEN_PIN, I2_PED_RED_PIN, I2_BUZZER_PIN };

enum VehState { V_GREEN, V_RED };

void setVehicleState(const Intersection &x, VehState s) {
  if (s == V_GREEN) {
    digitalWrite(x.greenPin, HIGH);
    digitalWrite(x.redPin, LOW);
    analogWrite(x.yellowPin, 0);
    digitalWrite(x.pedGreenPin, HIGH);
    digitalWrite(x.pedRedPin, LOW);
    noTone(x.buzzerPin);
  } else { // V_RED
    digitalWrite(x.greenPin, LOW);
    digitalWrite(x.redPin, HIGH);
    analogWrite(x.yellowPin, 0);
    digitalWrite(x.pedGreenPin, LOW);
    digitalWrite(x.pedRedPin, HIGH);
    noTone(x.buzzerPin);
  }
}

enum MasterPhase { PHASE_ACTIVE_GREEN, PHASE_ACTIVE_YELLOW };

Intersection* activeInt = &I1; // currently cycling through GREEN->YELLOW
Intersection* idleInt   = &I2; // held at RED for the whole active cycle
MasterPhase   masterPhase = PHASE_ACTIVE_GREEN;
unsigned long phaseStart = 0;
Fader         yellowFader;     // shared — safe because only one intersection
                                // is ever in YELLOW at a time (mutual exclusion
                                // by design, since idleInt is always RED)
bool          pedBlinkOn = false;
unsigned long pedBlinkLast = 0;

void enterGreen() {
  masterPhase = PHASE_ACTIVE_GREEN;
  phaseStart = millis();
  setVehicleState(*activeInt, V_GREEN);
  setVehicleState(*idleInt, V_RED);
}

void enterYellow() {
  masterPhase = PHASE_ACTIVE_YELLOW;
  phaseStart = millis();
  digitalWrite(activeInt->greenPin, LOW);
  faderStart(yellowFader, activeInt->yellowPin, 0, 255, PED_BLINK_INTERVAL_MS);
  pedBlinkOn = false;
  pedBlinkLast = millis();
  digitalWrite(activeInt->pedGreenPin, LOW);
}

void swapActiveIntersection() {
  Intersection* tmp = activeInt;
  activeInt = idleInt;
  idleInt = tmp;
}

void updateIntersections() {
  unsigned long now = millis();
  unsigned long elapsed = now - phaseStart;

  if (masterPhase == PHASE_ACTIVE_GREEN) {
    if (elapsed >= GREEN_DURATION_MS) enterYellow();
    return;
  }

  // PHASE_ACTIVE_YELLOW: fade bounces 0<->255 as a visual "blink" effect,
  // same 6-segment ratio the original design used
  if (faderUpdate(yellowFader)) {
    int newTarget = (yellowFader.target == 255) ? 0 : 255;
    faderStart(yellowFader, activeInt->yellowPin, yellowFader.value, newTarget, PED_BLINK_INTERVAL_MS);
  }

  // Pedestrian green blink + buzzer, synced to the same interval
  if (now - pedBlinkLast >= PED_BLINK_INTERVAL_MS) {
    pedBlinkLast = now;
    pedBlinkOn = !pedBlinkOn;
    digitalWrite(activeInt->pedGreenPin, pedBlinkOn ? HIGH : LOW);
    if (pedBlinkOn) tone(activeInt->buzzerPin, BUZZER_FREQ_HZ, BUZZER_BEEP_MS);
  }

  if (elapsed >= YELLOW_DURATION_MS) {
    analogWrite(activeInt->yellowPin, 0);
    digitalWrite(activeInt->pedGreenPin, LOW);
    noTone(activeInt->buzzerPin);
    swapActiveIntersection();
    enterGreen();
  }
}

// ============================================================================
//  CITY LIGHTS  (LDR + hysteresis, survives a missing/disconnected LDR)
// ============================================================================

bool cityLightsOn = false;
unsigned long lastLdrPoll = 0;
int ldrSmoothed = 512; // neutral starting point
Fader cityFader;

void updateCityLights() {
  unsigned long now = millis();
  if (now - lastLdrPoll < LDR_POLL_INTERVAL_MS) {
    faderUpdate(cityFader);
    return;
  }
  lastLdrPoll = now;

  int raw = analogRead(LDR_PIN); // if the LDR is missing, this just returns a
                                  // noisy/floating value — never blocks, never crashes
  ldrSmoothed = (ldrSmoothed * 3 + raw) / 4; // simple smoothing to reduce noise-driven flicker

  if (!cityLightsOn && ldrSmoothed < LDR_ON_THRESHOLD) {
    cityLightsOn = true;
    faderStart(cityFader, CITY_LIGHT_PIN, cityFader.active ? cityFader.value : 0, 255, CITY_FADE_DURATION_MS);
  } else if (cityLightsOn && ldrSmoothed > LDR_OFF_THRESHOLD) {
    cityLightsOn = false;
    faderStart(cityFader, CITY_LIGHT_PIN, cityFader.active ? cityFader.value : 255, 0, CITY_FADE_DURATION_MS);
  }

  faderUpdate(cityFader);
}

