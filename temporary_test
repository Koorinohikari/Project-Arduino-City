const int L_EN = 9;
const int L_IN1 = 8;
const int L_IN2 = 7;
const int R_EN = 10;
const int R_IN1 = 12;
const int R_IN2 = 13;

void setup() {
  pinMode(L_EN, OUTPUT);
  pinMode(L_IN1, OUTPUT);
  pinMode(L_IN2, OUTPUT);
  pinMode(R_EN, OUTPUT);
  pinMode(R_IN1, OUTPUT);
  pinMode(R_IN2, OUTPUT);
}

void testSide(int enPin, int in1, int in2, int speed, int ms) {
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  analogWrite(enPin, speed);
  delay(ms);
  analogWrite(enPin, 0);
  delay(500);
}

void loop() {
  testSide(L_EN, L_IN1, L_IN2, 200, 1000); // both left wheels
  testSide(R_EN, R_IN1, R_IN2, 200, 1000); // both right wheels
  delay(1000);
}